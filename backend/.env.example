# Google Gemini (backend only — never expose to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase (service role stays on the backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Educational CO2 estimate (kg CO2 per kWh). Default ~0.72 is a typical India-grid order of magnitude.
CO2_EMISSION_FACTOR_KG_PER_KWH=0.72

# CORS — comma-separated origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: bind host/port used by run.py
HOST=127.0.0.1
PORT=8000
